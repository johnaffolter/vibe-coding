@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix si: <https://superintelligence-homepage.example/ns#> .

# collection:vibe-project · grain: one row per project folder
<https://superintelligence-homepage.example/ns#CollectionVibeProjectShape> a sh:NodeShape ; sh:targetClass <https://superintelligence-homepage.example/ns#CollectionVibeProject> ; rdfs:comment "One project folder in a vibe-coding repo: something built with an AI assistant, with its prompts.md header saying what it is, how it went and whether it was worth it." ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_folder> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9_]+$" ; sh:message "collection:vibe-project.folder: required, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_title> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.title: required, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_files> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.files: optional, json." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_dateFirst> ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "collection:vibe-project.date_first: optional, date." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_dateLast> ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "collection:vibe-project.date_last: optional, date." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_defaults> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.defaults: optional, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_status> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:in ( "prototype" "keeper" "abandoned" "TBD" ) ; sh:message "collection:vibe-project.status: required, string, one of prototype | keeper | abandoned | TBD." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_use> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.use: optional, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_reusabilityArtifact> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "low" "medium" "high" "TBD" ) ; sh:message "collection:vibe-project.reusability_artifact: optional, string, one of low | medium | high | TBD." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_reusabilityPrompt> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "low" "medium" "high" "TBD" ) ; sh:message "collection:vibe-project.reusability_prompt: optional, string, one of low | medium | high | TBD." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_tags> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.tags: optional, json." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_takeaway> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.takeaway: optional, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_storyValue> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "none" "anecdote" "case study" "chapter-worthy" "TBD" ) ; sh:message "collection:vibe-project.story_value: optional, string, one of none | anecdote | case study | chapter-worthy | TBD." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibeProject_surprises> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-project.surprises: optional, string." ] ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "collection:vibe-project: (folder) must be unique" ; sh:select """SELECT $this WHERE { ?other a <https://superintelligence-homepage.example/ns#CollectionVibeProject> . FILTER(?other != $this) $this <https://superintelligence-homepage.example/ns#vibeProject_folder> ?k0 . ?other <https://superintelligence-homepage.example/ns#vibeProject_folder> ?k0 . }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "collection:vibe-project: (folder) must be unique" ; sh:select """SELECT $this WHERE { ?other a <https://superintelligence-homepage.example/ns#CollectionVibeProject> . FILTER(?other != $this) $this <https://superintelligence-homepage.example/ns#vibeProject_folder> ?k0 . ?other <https://superintelligence-homepage.example/ns#vibeProject_folder> ?k0 . }""" ] .

# collection:vibe-prompt · grain: one row per prompt per project
<https://superintelligence-homepage.example/ns#CollectionVibePromptShape> a sh:NodeShape ; sh:targetClass <https://superintelligence-homepage.example/ns#CollectionVibePrompt> ; rdfs:comment "One prompt in a project's prompts.md, with its context block: the tool and date, the session, how long it took, how well its result was verified and what a person changed afterward." ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_project> ; sh:maxCount 1 ; sh:minCount 1 ; sh:class <https://superintelligence-homepage.example/ns#CollectionVibeProject> ; sh:message "collection:vibe-prompt.project: required, points at collection:vibe-project." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_number> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:message "collection:vibe-prompt.number: required, integer." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_purpose> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-prompt.purpose: optional, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_tool> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-prompt.tool: required, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_date> ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "collection:vibe-prompt.date: optional, date." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_session> ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-prompt.session: optional, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_timeSeconds> ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:message "collection:vibe-prompt.time_seconds: optional, integer." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_verified> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:in ( "not-run" "syntax-checked" "agent-tested" "human-tested" ) ; sh:message "collection:vibe-prompt.verified: required, string, one of not-run | syntax-checked | agent-tested | human-tested." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_humanEdits> ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "collection:vibe-prompt.human_edits: required, string." ] ;
  sh:property [ sh:path <https://superintelligence-homepage.example/ns#vibePrompt_hasOutput> ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "collection:vibe-prompt.has_output: optional, boolean." ] ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "collection:vibe-prompt: (project, number) must be unique" ; sh:select """SELECT $this WHERE { ?other a <https://superintelligence-homepage.example/ns#CollectionVibePrompt> . FILTER(?other != $this) $this <https://superintelligence-homepage.example/ns#vibePrompt_project> ?k0 . ?other <https://superintelligence-homepage.example/ns#vibePrompt_project> ?k0 . $this <https://superintelligence-homepage.example/ns#vibePrompt_number> ?k1 . ?other <https://superintelligence-homepage.example/ns#vibePrompt_number> ?k1 . }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "collection:vibe-prompt: (project, number) must be unique" ; sh:select """SELECT $this WHERE { ?other a <https://superintelligence-homepage.example/ns#CollectionVibePrompt> . FILTER(?other != $this) $this <https://superintelligence-homepage.example/ns#vibePrompt_project> ?k0 . ?other <https://superintelligence-homepage.example/ns#vibePrompt_project> ?k0 . $this <https://superintelligence-homepage.example/ns#vibePrompt_number> ?k1 . ?other <https://superintelligence-homepage.example/ns#vibePrompt_number> ?k1 . }""" ] .
